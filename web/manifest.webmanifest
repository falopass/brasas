{
  "name": "BRASA Chile — alertas de incendios por lugar",
  "short_name": "BRASA",
  "description": "Focos de calor satelitales cerca de tus lugares, riesgo 30-30-30 por comuna y reconstrucción de incendios. No reemplaza a SENAPRED ni a CONAF.",
  "lang": "es-CL",
  "id": "/",
  "start_url": "/#/mi-zona",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0c0b",
  "theme_color": "#0d0c0b",
  "categories": ["weather", "utilities", "navigation"],
  "icons": [
    {"src": "/web/icons/icon.svg", "sizes": "any", "type": "image/svg+xml"},
    {"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/web/icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/web/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "¿Hay fuego cerca de mí?", "url": "/#/mi-zona",
     "icons": [{"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Reportar lo que veo", "url": "/#/mapa",
     "icons": [{"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Riesgo por comuna", "url": "/#/riesgo",
     "icons": [{"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Emergencias", "url": "/#/preparate",
     "icons": [{"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Hoja de emergencia", "url": "/lista.html",
     "icons": [{"src": "/web/icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "/compartir-foto",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "foto", "accept": ["image/*"]}]
    }
  }
}
