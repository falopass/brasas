# ---------------------------------------------------------------------------
# BRASA Chile — configuración local. Copia este archivo como .env (no lo publiques).
# ---------------------------------------------------------------------------

# NASA FIRMS (VIIRS/MODIS). Clave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Productos casi en tiempo real que se ingieren cada ciclo (separados por coma).
# VIIRS S-NPP deja de entregarse el 2 de noviembre de 2026: no lo incluyas por defecto.
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT

# GOES-Este (NOAA, cada 10 minutos, sin clave). 1 = activado.
GOES_ENABLED=1

# Frecuencia de ingesta de focos (minutos, mínimo 5) y de cálculo del índice 30-30-30 (mínimo 60).
INGEST_INTERVAL_MIN=10
RISK_INTERVAL_MIN=180

# Telegram (opcional): crea un bot con @BotFather y pega el token y el nombre de usuario.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Dirección pública del sitio (para los enlaces en las alertas) y contacto VAPID para Web Push.
PUBLIC_BASE_URL=http://127.0.0.1:8000
VAPID_CONTACT=mailto:contacto@example.org

# Moderación de reportes ciudadanos: token largo y secreto para /admin (vacío = desactivada).
ADMIN_TOKEN=

# Antibot en el formulario de reportes (Cloudflare Turnstile). La clave de sitio es pública;
# la secreta nunca sale del servidor. Vacías = sin verificación (útil en desarrollo local).
# Las claves las crea la persona dueña en el panel de Cloudflare → Turnstile (docs/DESPLIEGUE_CLOUDFLARE.md).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Opcional: relieve 3D real. Token PÚBLICO con permisos mínimos y restricción de dominio.
# https://ion.cesium.com/tokens
CESIUM_ION_PUBLIC_TOKEN=

# Apaga las tareas automáticas (útil para pruebas): BRASA_SCHEDULER=0
BRASA_SCHEDULER=1

# Carpeta de las bases (brasa.db = datos de las personas, work.db = observaciones, incidentes y riesgo).
# Vacío = ./data. `python dev.py run --demo` usa ./data/demo con datos de ejemplo.
BRASA_DATA_DIR=

# ---------------------------------------------------------------------------
# Solo en Cloudflare (los pone el Worker; en local déjalos vacíos)
# ---------------------------------------------------------------------------
# Respaldo remoto: <URL pública>/_internal/storage, protegido con INTERNAL_TOKEN.
BRASA_STORAGE_URL=
INTERNAL_TOKEN=
# Telegram por webhook en vez de consulta periódica.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Límites de uso de las APIs externas
# ---------------------------------------------------------------------------
# Consultas diarias por IP al archivo satelital (/api/explore). Protege la cuota de FIRMS.
EXPLORE_DAILY_LIMIT=200
# Celdas de normales de lluvia (1991-2020) que se completan por vuelta del ciclo, cada 6 h.
# Son 153 celdas de 30 años de archivo; con 12 por vuelta se completa en unos 3 días. 0 las congela.
RAIN_NORMALS_PER_RUN=12
